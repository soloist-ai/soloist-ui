extend type Mutation {
    createCustomTask(name: String!): CreateCustomTaskResult!
}

# ── Domain types ─────────────────────────────────────────

type Task {
    id: UUID!
    type: TaskType!
    name: String
    goal: Int!
    progress: Int!
    gemReward: Int!
    isCompleted: Boolean!
    proofType: ProofType!
    day: Date!
    createdAt: DateTime!
}

# ── Result types ─────────────────────────────────────────

type TasksResult {
    tasks: [Task!]!
}

type TaskHistoryResult {
    tasks: [Task!]!
    paging: ResponsePaging!
}

type CreateCustomTaskResult {
    isValid: Boolean!
    rejectionReason: String
    task: Task
}

# ── Enums ────────────────────────────────────────────────

enum TaskType {
    STEPS
    PUSH_UPS
    SQUATS
    CUSTOM
}

enum ProofType {
    TEXT
    PHOTO
    VIDEO
}

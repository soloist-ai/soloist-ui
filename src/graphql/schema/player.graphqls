# ── Domain types ─────────────────────────────────────────

type Player {
    id: Long!
    balance: Balance!
    stamina: Stamina!
    dayStreak: DayStreak!
    monthlyActivity(year: Int!, month: Int!): MonthlyActivityResult!
    tasks: TasksResult!
    taskHistory(paging: PagingInput!): TaskHistoryResult!
}

type Stamina {
    id: UUID!
    current: Int!
    max: Int!
    isRegenerating: Boolean!
    regenRate: Int!
    regenIntervalSeconds: Int!
    nextRegenAt: DateTime
    fullRegenAt: DateTime
}

type DayStreak {
    id: UUID!
    current: Int!
    max: Int!
    isExtendedToday: Boolean!
}

# ── Result types ─────────────────────────────────────────

type MonthlyActivityResult {
    activeDays: [Int!]!
}
